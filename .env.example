# Plantilla de variables de entorno locales. Copiar a `.env` (git-ignored) y rellenar.
#
# Clave de la API de Gemini para el validador de quórum cross-vendor
# (scripts/validate-with-gemini.mjs). Se obtiene en https://aistudio.google.com/apikey
# El tier gratuito sirve para gemini-2.5-flash; gemini-2.5-pro requiere facturación.
GEMINI_API_KEY=

# Clave de la API de DeepSeek (OpenAI-compatible). https://platform.deepseek.com/api_keys
# Modelos: deepseek-v4-flash, deepseek-v4-pro.
DEEPSEEK_API_KEY=
